---
import Base from '../layouts/Base.astro';
import { SITE } from '../site.config';
---
<Base title="Contact & claim a listing" description={`Contact ${SITE.name}, suggest a business, or claim and correct your listing.`}>
  <div class="narrow stack prose" style="padding:32px 16px">
    <h1>Contact us</h1>
    <p>Suggest a spot, report a change, or claim your business listing.</p>
    <p>Email: <a href="mailto:hello@example.com">[hello@yourdomain.com]</a></p>
  </div>
</Base>
