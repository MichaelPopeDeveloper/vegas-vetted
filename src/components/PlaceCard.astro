---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { areaBySlug, placeAreas } from '../data/taxonomy';
import { placeUrl, mapsUrl } from '../lib/schema';

interface Props { place: CollectionEntry<'places'>; rank?: number; headingLevel?: 'h2' | 'h3' }
const { place, rank, headingLevel = 'h2' } = Astro.props;
const d = place.data;
const area = areaBySlug(d.area);
const { Content } = await render(place);
const H = headingLevel;
const tel = d.phone?.replace(/[^\d+]/g, '');
---
<li class="card" data-area={placeAreas(d).join("|")} data-tags={d.tags.join('|').toLowerCase()} id={place.id}>
  <div class="card-media">
    {d.image ? <img src={d.image} alt={`${d.name}`} width="800" height="450" loading={rank && rank <= 1 ? 'eager' : 'lazy'} decoding="async" /> : <span>Photo coming soon</span>}
    {rank && <span class="rank" aria-label={`Number ${rank}`}>{rank}</span>}
  </div>
  <div class="card-body">
    <div class="card-title">
      <H><a href={placeUrl(place)}>{d.name}</a></H>
      {d.price && <span class="muted">{d.price}</span>}
    </div>
    <div class="card-tags">
      {area && <span class="tag">{area.name}{d.locations.length > 0 && ` + ${d.locations.length} more`}</span>}
      {d.tags.map((t) => <span class="tag tag-ok">{t}</span>)}
    </div>
    <div class="take"><Content /></div>
    <div class="card-actions">
      <a class="btn btn-primary" href={mapsUrl(place)} rel="noopener" target="_blank">Directions</a>
      {tel && /\d{7,}/.test(tel) ? <a class="btn" href={`tel:${tel}`}>Call</a> : <a class="btn" href={placeUrl(place)}>Details</a>}
      {d.website ? <a class="btn" href={d.website} rel="noopener nofollow" target="_blank">Website</a> : <a class="btn" href={placeUrl(place)}>More</a>}
    </div>
  </div>
</li>
